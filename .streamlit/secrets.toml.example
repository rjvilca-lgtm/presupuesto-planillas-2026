# Copia este archivo a  .streamlit/secrets.toml  y completa los valores.
# NUNCA subas secrets.toml al repositorio (ya está en .gitignore).
# En Streamlit Community Cloud, pega este contenido en Settings → Secrets.
#
# Si NO defines la sección [sql], la app corre en modo demostración.

[sql]
server   = "ucsp.database.windows.net"
database = "saldos"
username = "svc_presupuesto"   # cuenta de servicio con permisos mínimos
password = "REEMPLAZAR"        # rota la credencial que estaba en las macros
